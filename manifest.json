{
  "manifest_version": 3,
  "name": "QC Auditor – Website Quality Checker",
  "version": "2.0.0",
  "description": "Instantly analyze any website — SEO, Performance, Accessibility & Best Practices scored out of 100 with actionable fixes, history tracking, and SEO X-Ray.",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "QC Auditor – Website Quality Checker"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
